{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=BankingSystemDb;User Id=sa;Password=Your_Secure_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "BankingSystemApi",
    "Audience": "BankingSystemClients",
    "SecretKey": "YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_FOR_SHA256_IN_PRODUCTION",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerHour": 5,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
