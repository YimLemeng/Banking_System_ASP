# ==============================================================================
# Enterprise Banking System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your local settings.

# Database Connection (SQL Server)
DB_CONNECTION="Server=localhost,1433;Database=banking_system_db;User Id=sa;Password=YourStrongPassword;TrustServerCertificate=True;MultipleActiveResultSets=true"
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=banking_system_db;User Id=sa;Password=YourStrongPassword;TrustServerCertificate=True;MultipleActiveResultSets=true"

# JWT Secret Key (Must be at least 32 characters for HMAC-SHA256)
JWT_SECRET="Your32ByteOrLongerSuperSecretKeyForJwtAuthenticationGoesHere!"
Jwt__SecretKey="Your32ByteOrLongerSuperSecretKeyForJwtAuthenticationGoesHere!"

# Initial Seed Credentials (Only used when initializing a fresh database)
ADMIN_DEFAULT_PASSWORD="YourStrongAdminPassword123!"
TELLER_DEFAULT_PASSWORD="YourStrongTellerPassword123!"
